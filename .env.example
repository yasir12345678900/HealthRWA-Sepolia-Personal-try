# HALAH on-chain mode (Ethereum Sepolia). Copy this file to .env and fill it in.
# .env is git-ignored - NEVER commit real keys. Use a TEST wallet only.
# PRIVATE_KEY must belong to the SAME wallet that deployed the contract (mint/revoke are onlyOwner).
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONSENTSBTV3_ADDRESS
CONTRACT_VERSION=3
PRIVATE_KEY=0xYOUR_TEST_WALLET_PRIVATE_KEY
