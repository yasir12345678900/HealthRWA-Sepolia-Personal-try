pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC721/ERC721.sol";
import "@openzeppelin/contracts/access/Ownable.sol";

/// @title ERC-5484 (Consensual Soulbound Token) interface
interface IERC5484 {
    enum BurnAuth { IssuerOnly, OwnerOnly, Both, Neither }
    event Issued(address indexed from, address indexed to, uint256 indexed tokenId, BurnAuth burnAuth);
    function burnAuth(uint256 tokenId) external view returns (BurnAuth);
}

/// @title Poseidon hash of two field elements. The bytecode of this contract is generated by circomlibjs
///        (poseidonContract.createCode(2)), so that the chain, the circuit and the off-chain code compute the same hash.
interface IPoseidonT3 {
    function poseidon(uint256[2] calldata input) external pure returns (uint256);
}

/// @title HALAH Consent SBT v4 - commitment-only Soulbound token with the consent tree and the revocation tree.
/// @notice Revised from ConsentSBTv3 (Algorithm 5.3). A token stores only the hiding commitment c of its consent and
///         its revocation state. No party, purpose, window or context is on chain, and the mint takes nothing else.
///         The contract keeps two Merkle trees of depth 16 over the Poseidon hash:
///         - the consent tree, where leaf i is the commitment of the i-th issued consent (token i + 1), with the
///           current root and the last 8 roots, so that a mint during proving does not void a proof;
///         - the revocation tree, where leaf i is 0 while that consent is not revoked and 1 once it is revoked.
///         Temporal validity is proved against the commitment (Chapter 7), so checkValidAt of v3 is retired and
///         checkValid reports the revocation state only.
contract ConsentSBTv4 is ERC721, Ownable, IERC5484 {
    /// Depth of both trees, so the contract can hold 2^16 consents.
    uint256 public constant TREE_DEPTH = 16;
    /// Number of earlier consent roots that stay acceptable beside the current one.
    uint256 public constant RECENT_ROOTS = 8;
    /// Order of the BN254 scalar field. A commitment is an element of this field.
    uint256 public constant FIELD = 21888242871839275222246405745257275088548364400416034343698204186575808495617;

    uint256 private constant ROOT_SLOTS = RECENT_ROOTS + 1;      // the current root and the last 8
    uint256 private constant MAX_CONSENTS = 1 << TREE_DEPTH;

    struct Consent {
        uint256 commitment;   // c, the only consent data on chain
        bool    revoked;      // E, set once and never cleared
    }

    IPoseidonT3 public immutable hasher;

    /// tokenId => the commitment and the revocation state. Token n holds leaf n - 1 of both trees.
    mapping(uint256 => Consent) public consents;
    /// commitment => tokenId (0 = not issued). One commitment is one token and one revocation leaf.
    mapping(uint256 => uint256) public tokenOfCommitment;
    /// Root of the revocation tree. Only the current one is acceptable to the verifier.
    uint256 public revocationRoot;

    uint32 private _count;                                        // consents issued = next free leaf
    uint8  private _rootPos;                                      // position of the current root in _roots
    uint256[ROOT_SLOTS] private _roots;                           // ring of the current root and the last 8
    uint256[TREE_DEPTH] private _frontier;                        // last complete left subtree at each height
    mapping(uint256 => mapping(uint256 => uint256)) private _revocationNodes;   // height => index => node (heights 1 to 15)

    event ConsentIssued(uint256 indexed tokenId, uint256 commitment);
    event ConsentRevoked(uint256 indexed tokenId);

    /// @param poseidonT3 address of the Poseidon contract for two inputs. The constructor recomputes the roots of
    ///        the empty subtrees with it and refuses a hasher that does not reproduce the constants of _zero.
    constructor(address poseidonT3) ERC721("MedicalConsent", "CONSENT") {
        hasher = IPoseidonT3(poseidonT3);
        for (uint256 h = 0; h < TREE_DEPTH; h++) {
            require(_hash(_zero(h), _zero(h)) == _zero(h + 1), "hasher is not Poseidon");
        }
        _roots[0] = _zero(TREE_DEPTH);
        revocationRoot = _zero(TREE_DEPTH);
    }

    // ---- issuance (Algorithm 5.3) -----------------------------------------------------------------------------

    /// Mint the token of a consent once the guardians' threshold is met off chain. `to` is a per-consent address,
    /// so one address holds at most one token and two consents of a patient are not linked by their holder.
    function mintConsent(address to, uint256 commitment) external onlyOwner returns (uint256 tokenId) {
        require(commitment != 0 && commitment < FIELD, "commitment outside the field");
        require(tokenOfCommitment[commitment] == 0, "commitment already issued");
        require(balanceOf(to) == 0, "address already holds a consent");
        uint256 index = _count;
        require(index < MAX_CONSENTS, "consent tree is full");
        tokenId = index + 1;
        _count = uint32(tokenId);
        consents[tokenId] = Consent(commitment, false);
        tokenOfCommitment[commitment] = tokenId;
        _mint(to, tokenId);
        _insertCommitment(index, commitment);
        emit ConsentIssued(tokenId, commitment);
        emit Issued(msg.sender, to, tokenId, BurnAuth.Neither);
    }

    /// Insert leaf `index` of the consent tree and record the new root. Only one node has to be kept for later
    /// inserts: the lowest node on the path that is a left child, because its subtree is complete after this insert.
    function _insertCommitment(uint256 index, uint256 leaf) private {
        uint256 node = leaf;
        uint256 idx = index;
        bool kept = false;
        for (uint256 h = 0; h < TREE_DEPTH; h++) {
            if (idx & 1 == 0) {
                if (!kept) { _frontier[h] = node; kept = true; }
                node = _hash(node, _zero(h));          // nothing is issued to the right yet
            } else {
                node = _hash(_frontier[h], node);      // the complete subtree on the left
            }
            idx >>= 1;
        }
        uint8 pos = uint8((_rootPos + 1) % ROOT_SLOTS);
        _rootPos = pos;
        _roots[pos] = node;
    }

    // ---- revocation (Algorithm 6.4, on-chain step) ------------------------------------------------------------

    /// Revoke a consent. There is no function that clears the flag or restores the leaf, so revocation is final.
    function revoke(uint256 tokenId) external onlyOwner {
        require(_exists(tokenId), "no token");
        require(!consents[tokenId].revoked, "already revoked");
        consents[tokenId].revoked = true;
        _setRevocationLeaf(tokenId - 1);
        emit ConsentRevoked(tokenId);
    }

    /// Set leaf `index` of the revocation tree to 1 and recompute the root along its path. The leaves are the
    /// revocation flags themselves, and the inner nodes are stored so that the next revocation finds its siblings.
    function _setRevocationLeaf(uint256 index) private {
        uint256 sibling = consents[(index ^ 1) + 1].revoked ? 1 : 0;
        uint256 node = index & 1 == 0 ? _hash(1, sibling) : _hash(sibling, 1);
        uint256 idx = index >> 1;
        for (uint256 h = 1; h < TREE_DEPTH; h++) {
            _revocationNodes[h][idx] = node;
            sibling = _revocationNodes[h][idx ^ 1];
            if (sibling == 0) sibling = _zero(h);      // a subtree without a revocation
            node = idx & 1 == 0 ? _hash(node, sibling) : _hash(sibling, node);
            idx >>= 1;
        }
        revocationRoot = node;
    }

    // ---- views ------------------------------------------------------------------------------------------------

    /// Reports the revocation state: true for an issued consent that is not revoked.
    function checkValid(uint256 tokenId) external view returns (bool) {
        return _exists(tokenId) && !consents[tokenId].revoked;
    }

    /// Current root of the consent tree.
    function consentRoot() public view returns (uint256) {
        return _roots[_rootPos];
    }

    /// True for the current root of the consent tree and for the last 8 roots before it.
    function isKnownConsentRoot(uint256 root) external view returns (bool) {
        if (root == 0) return false;
        uint256 pos = _rootPos;
        for (uint256 i = 0; i < ROOT_SLOTS; i++) {
            if (_roots[pos] == root) return true;
            pos = pos == 0 ? ROOT_SLOTS - 1 : pos - 1;
        }
        return false;
    }

    /// The current root first, then the earlier roots from the newest to the oldest (0 where there is none yet).
    function recentRoots() external view returns (uint256[ROOT_SLOTS] memory out) {
        uint256 pos = _rootPos;
        for (uint256 i = 0; i < ROOT_SLOTS; i++) {
            out[i] = _roots[pos];
            pos = pos == 0 ? ROOT_SLOTS - 1 : pos - 1;
        }
    }

    /// Number of consents issued, which is also the index of the next free leaf.
    function consentCount() external view returns (uint256) {
        return _count;
    }

    // ---- Soulbound (ERC-5484) ---------------------------------------------------------------------------------

    /// A token is minted once and never moves: every transfer between accounts is refused, and no token is burnt.
    function _beforeTokenTransfer(address from, address to, uint256 firstTokenId, uint256 batchSize) internal override {
        require(from == address(0), "Soulbound Token");
        super._beforeTokenTransfer(from, to, firstTokenId, batchSize);
    }

    /// Nobody may burn a token. A consent ends by revocation, which keeps the token and its revocation state.
    function burnAuth(uint256 tokenId) external view override returns (BurnAuth) {
        require(_exists(tokenId), "no token");
        return BurnAuth.Neither;
    }

    /// The owner cannot be given up: without an owner no consent could be issued or revoked any more.
    function renounceOwnership() public view override onlyOwner {
        revert("ownership cannot be renounced");
    }

    function supportsInterface(bytes4 interfaceId) public view override returns (bool) {
        return interfaceId == type(IERC5484).interfaceId || super.supportsInterface(interfaceId);
    }

    // ---- Poseidon ---------------------------------------------------------------------------------------------

    function _hash(uint256 left, uint256 right) private view returns (uint256) {
        return hasher.poseidon([left, right]);
    }

    /// Root of an empty subtree of the given height: Z(0) = 0 and Z(h + 1) = Poseidon(Z(h), Z(h)).
    /// The values are those of circomlibjs. tools/compile_v4.js recomputes them and refuses to build on a difference.
    function _zero(uint256 height) private pure returns (uint256) {
        if (height == 0) return 0;
        if (height == 1) return 0x2098f5fb9e239eab3ceac3f27b81e481dc3124d55ffed523a839ee8446b64864;
        if (height == 2) return 0x1069673dcdb12263df301a6ff584a7ec261a44cb9dc68df067a4774460b1f1e1;
        if (height == 3) return 0x18f43331537ee2af2e3d758d50f72106467c6eea50371dd528d57eb2b856d238;
        if (height == 4) return 0x07f9d837cb17b0d36320ffe93ba52345f1b728571a568265caac97559dbc952a;
        if (height == 5) return 0x2b94cf5e8746b3f5c9631f4c5df32907a699c58c94b2ad4d7b5cec1639183f55;
        if (height == 6) return 0x2dee93c5a666459646ea7d22cca9e1bcfed71e6951b953611d11dda32ea09d78;
        if (height == 7) return 0x078295e5a22b84e982cf601eb639597b8b0515a88cb5ac7fa8a4aabe3c87349d;
        if (height == 8) return 0x2fa5e5f18f6027a6501bec864564472a616b2e274a41211a444cbe3a99f3cc61;
        if (height == 9) return 0x0e884376d0d8fd21ecb780389e941f66e45e7acce3e228ab3e2156a614fcd747;
        if (height == 10) return 0x1b7201da72494f1e28717ad1a52eb469f95892f957713533de6175e5da190af2;
        if (height == 11) return 0x1f8d8822725e36385200c0b201249819a6e6e1e4650808b5bebc6bface7d7636;
        if (height == 12) return 0x2c5d82f66c914bafb9701589ba8cfcfb6162b0a12acf88a8d0879a0471b5f85a;
        if (height == 13) return 0x14c54148a0940bb820957f5adf3fa1134ef5c4aaa113f4646458f270e0bfbfd0;
        if (height == 14) return 0x190d33b12f986f961e10c0ee44d8b9af11be25588cad89d416118e4bf4ebe80c;
        if (height == 15) return 0x22f98aa9ce704152ac17354914ad73ed1167ae6596af510aa5b3649325e06c92;
        if (height == 16) return 0x2a7c7c9b6ce5880b9f6f228d72bf6a575a526f29c66ecceef8b753d38bba7323;
        revert("height out of range");
    }
}
